# Configure values privately. Never commit .env.local.
AUTH_SECRET=
AUTH_EMAIL_SENDER_ID=
# Exactly two different email addresses. Login verifies access to their inboxes.
PORTAL_ALLOWED_EMAILS=
PORTAL_OWNER_EMAIL=
AUTH_URL=http://localhost:3000
BREVO_API_KEY=
BREVO_LIST_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
DATABASE_URL=
# Sending is disabled unless explicitly enabled in production.
PORTAL_SEND_ENABLED=false
# Preview can only send to this separately configured test list.
PORTAL_TEST_LIST_ID=
# Optional localhost-only sample data. Never supported on Vercel or production.
PORTAL_DEMO=false
